{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile picture URL" },
        "isAnonymous": { "type": "boolean", "description": "Whether the user is anonymous" }
      },
      "required": ["uid"]
    },
    "UserRoleRecord": {
      "title": "UserRoleRecord",
      "description": "Server-controlled user role and lawyer authorization status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "email": { "type": "string", "description": "User email" },
        "role": { "type": "string", "enum": ["USER", "LAWYER", "ADMIN"], "description": "Assigned role" },
        "lawyerStatus": { "type": "string", "enum": ["NONE", "PENDING", "APPROVED", "REJECTED", "SUSPENDED"], "description": "Lawyer verification status" },
        "barEnrollmentNumber": { "type": "string", "description": "Bar council enrollment ID" },
        "stateBarCouncil": { "type": "string", "description": "State bar council name" },
        "assignedAt": { "type": "number", "description": "Timestamp of role assignment" },
        "assignedBy": { "type": "string", "description": "Admin UID or system" },
        "isSuspended": { "type": "boolean", "description": "Whether user is suspended" }
      },
      "required": ["uid", "role", "lawyerStatus", "assignedAt"]
    },
    "LawyerApplication": {
      "title": "LawyerApplication",
      "description": "Application submitted by an advocate for verification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Application ID" },
        "userId": { "type": "string", "description": "Applicant UID" },
        "fullName": { "type": "string", "description": "Advocate full name" },
        "email": { "type": "string", "description": "Advocate email" },
        "barEnrollmentNumber": { "type": "string", "description": "Bar Council enrollment ID" },
        "stateBarCouncil": { "type": "string", "description": "State Bar Council" },
        "experienceYears": { "type": "number", "description": "Years of legal practice" },
        "practiceAreas": { "type": "array", "description": "Specializations" },
        "verificationStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "SUSPENDED"], "description": "Verification state" },
        "adminNotes": { "type": "string", "description": "Notes from reviewing administrator" },
        "submittedAt": { "type": "number", "description": "Submission timestamp" },
        "reviewedAt": { "type": "number", "description": "Review timestamp" },
        "reviewedBy": { "type": "string", "description": "Reviewing Admin UID" }
      },
      "required": ["id", "userId", "fullName", "email", "barEnrollmentNumber", "stateBarCouncil", "verificationStatus", "submittedAt"]
    },
    "SharedLegalSource": {
      "title": "SharedLegalSource",
      "description": "Authoritative judgment or statute in the global library",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Source ID" },
        "title": { "type": "string", "description": "Case name or statutory title" },
        "citation": { "type": "string", "description": "Official law reporter citation" },
        "court": { "type": "string", "description": "Adjudicating bench/court" },
        "date": { "type": "string", "description": "Judgment date" },
        "status": { "type": "string", "enum": ["UNDER_REVIEW", "ADMIN_APPROVED", "REJECTED", "ARCHIVED"], "description": "Library approval state" },
        "sourceType": { "type": "string", "description": "Type of legal document" },
        "rawText": { "type": "string", "description": "Full verbatim text of authority" },
        "uploadedBy": { "type": "string", "description": "Uploader Admin UID" },
        "uploadedAt": { "type": "number", "description": "Upload timestamp" },
        "reviewedBy": { "type": "string", "description": "Reviewing Admin UID" },
        "reviewedAt": { "type": "number", "description": "Review timestamp" },
        "adminReviewNotes": { "type": "string", "description": "Editorial verification notes" },
        "isVerified": { "type": "boolean", "description": "Grounding verification flag" },
        "statutesReferenced": { "type": "array", "description": "Statutes cited in judgment" },
        "keyTopics": { "type": "array", "description": "Legal topic tags" }
      },
      "required": ["id", "title", "citation", "court", "status", "rawText", "uploadedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable security and administrative audit event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry ID" },
        "action": { "type": "string", "description": "Action performed" },
        "performedByUid": { "type": "string", "description": "User UID who triggered action" },
        "performedByEmail": { "type": "string", "description": "Email of user" },
        "targetEntityId": { "type": "string", "description": "ID of affected entity" },
        "targetEntityType": { "type": "string", "description": "Type of affected entity" },
        "details": { "type": "string", "description": "Contextual description" },
        "ipAddress": { "type": "string", "description": "Request IP address" },
        "timestamp": { "type": "number", "description": "Event timestamp" }
      },
      "required": ["id", "action", "performedByUid", "timestamp"]
    },
    "ResearchSession": {
      "title": "ResearchSession",
      "description": "User private legal research workspace session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Session title" },
        "researchQuestion": { "type": "string", "description": "Primary proposition" },
        "legalTopic": { "type": "string", "description": "Domain of law" },
        "notes": { "type": "string", "description": "Notes" },
        "sourceDocumentIds": { "type": "array", "description": "Attached source IDs" },
        "messages": { "type": "array", "description": "Messages" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "SavedFinding": {
      "title": "SavedFinding",
      "description": "Private user saved proposition or quotation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Finding ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Finding title" },
        "findingText": { "type": "string", "description": "Text" },
        "savedAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["id", "userId", "title", "findingText", "savedAt"]
    },
    "ResearchDigest": {
      "title": "ResearchDigest",
      "description": "Private executive research digest",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Digest ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "generatedAt": { "type": "number", "description": "Timestamp" },
        "periodLabel": { "type": "string", "description": "Period" },
        "keyFindingsSummary": { "type": "string", "description": "Summary" }
      },
      "required": ["id", "userId", "generatedAt", "periodLabel", "keyFindingsSummary"]
    }
  },
  "firestore": {
    "/userRoles/{uid}": {
      "schema": { "$ref": "UserRoleRecord" },
      "description": "Server-controlled user authorization and role records"
    },
    "/lawyerApplications/{applicationId}": {
      "schema": { "$ref": "LawyerApplication" },
      "description": "Advocate verification requests and review statuses"
    },
    "/legalSources/{sourceId}": {
      "schema": { "$ref": "SharedLegalSource" },
      "description": "Global authoritative legal source repository"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "AuditLogEntry" },
      "description": "Privileged activity and administrative audit logs"
    },
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/researchSessions/{sessionId}": {
      "schema": { "$ref": "ResearchSession" },
      "description": "User private research sessions"
    },
    "/users/{userId}/findings/{findingId}": {
      "schema": { "$ref": "SavedFinding" },
      "description": "User private findings"
    },
    "/users/{userId}/digests/{digestId}": {
      "schema": { "$ref": "ResearchDigest" },
      "description": "User private digests"
    }
  }
}
